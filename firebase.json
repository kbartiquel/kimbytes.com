{
  "hosting": {
    "site": "kimbytes-website",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "!(*.@(png|jpg|jpeg|gif|webp|svg|ico|css|js))",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/!(*.@(png|jpg|jpeg|gif|webp|svg|ico|css|js))",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
